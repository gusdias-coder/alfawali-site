---
import Icon from './Icon.astro';
import ProductArt from './ProductArt.astro';
import { categories } from '../data/company';
import type { Product } from '../data/products';
interface Props { product: Product }
const { product } = Astro.props;
const category = categories.find(c => c.id === product.category)!;
---
<article class="product-card" data-product-card data-id={product.id} data-category={product.category} data-name={product.name}>
  <div class="product-visual"><span class="demo-label">Exemplo ilustrativo</span><ProductArt kind={product.illustration}/></div>
  <div class="product-content"><span class="eyebrow muted">{category.name}</span><h3>{product.name}</h3><p>{product.description}</p><div class="product-bottom"><span>Por {product.unit}<small>Sob consulta</small></span><button class="add-button" type="button" data-add={product.id} aria-label={`Adicionar ${product.name} à cotação`}><Icon name="plus" size={19}/><span>Adicionar</span></button></div></div>
</article>
