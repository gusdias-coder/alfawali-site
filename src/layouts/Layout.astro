---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { company } from '../data/company';
import { path, contact } from '../lib/urls';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
const quotePage = Astro.url.pathname.endsWith('/orcamento/');
import { isProd } from '../lib/env';
interface Props { title: string; description?: string; active?: string }
const pageDescriptions: Record<string,string> = {
  'Produtos de limpeza e suprimentos para empresas': 'Explore as linhas de limpeza, higiene, descartáveis e suprimentos da ALFAWALI. Organize sua seleção e prepare uma solicitação de orçamento.',
  'Catálogo de produtos': 'Consulte o catálogo demonstrativo ALFAWALI por nome, código ou categoria. Veja unidades, embalagens e detalhes antes de preparar sua cotação.',
  'A empresa': 'Conheça a ALFAWALI, sua identificação empresarial e as frentes de fornecimento de suprimentos e prestação de serviços terceirizados.',
  'Fale com a ALFAWALI': 'Prepare seu contato com a ALFAWALI. Informe sua cidade e necessidade, revise a mensagem e abra o WhatsApp para conversar sobre produtos ou serviços.',
  'Privacidade na apresentação': 'Saiba como a prévia ALFAWALI utiliza a lista local de cotação, a preferência de aparência e os campos usados para preparar uma mensagem.',
  'Página não encontrada': 'A página solicitada não foi encontrada. Volte ao início da ALFAWALI para acessar o catálogo, os serviços ou os canais de contato.',
};
const { title, description = pageDescriptions[Astro.props.title] || 'Produtos, suprimentos e serviços ALFAWALI. Consulte sua necessidade e as condições de atendimento.', active = '' } = Astro.props;
const nav = [{ name: 'Início', href: '', id: 'home' }, { name: 'Produtos', href: 'produtos/', id: 'produtos' }, { name: 'Serviços', href: 'servicos/', id: 'servicos' }, { name: 'A empresa', href: 'empresa/', id: 'empresa' }, { name: 'Atendimento', href: 'atendimento/', id: 'atendimento' }, { name: 'Contato', href: 'contato/', id: 'contato' }];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const csp = "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'";
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>{import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp}/>}<script is:inline src={path('theme-init.js')}></script><meta name="color-scheme" content="light dark"/><meta name="referrer" content="strict-origin-when-cross-origin"/><title>{title} | ALFAWALI</title><meta name="description" content={description}/>{isProd ? <meta name="robots" content="index, follow"/> : <meta name="robots" content="noindex, nofollow"/>}{isProd && canonical && <link rel="canonical" href={canonical}/>}<meta name="theme-color" content="#173747"/><meta property="og:title" content={`${title} | ALFAWALI`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="pt_BR"/><link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/></head>
<body>
  <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
  {company.demo && <div class="preview-bar"><div class="container preview-inner"><span><span class="status-dot"></span> Catálogo demonstrativo · condições a confirmar</span><a href={path('atendimento/')}>Atendimento no RS sob consulta <Icon name="diagonal" size={14}/></a></div></div>}
  <header class="site-header"><div class="container nav-row"><a class="brand" href={path()} aria-label="ALFAWALI - início"><img src={path('images/logo.png')} alt="ALFAWALI" width="115" height="80" fetchpriority="high"/></a><button class="menu-button" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="main-nav" data-menu hidden><Icon name="menu"/></button><nav id="main-nav" aria-label="Menu principal">{nav.map(item => <a href={path(item.href)} aria-current={active === item.id ? 'page' : undefined}>{item.name}</a>)}</nav><a class="quote-trigger" href={path("orcamento/")} data-open-quote><Icon name="list" size={20}/><span>Minha cotação</span><span class="cart-count" data-cart-count aria-label="itens na cotação">0</span></a></div></header>
  <main id="conteudo"><slot/></main>
  <div itemscope itemtype="https://schema.org/Organization">
  <meta itemprop="name" content={company.name}/><meta itemprop="legalName" content={company.legalName}/><meta itemprop="taxID" content={company.cnpj}/>
  <footer class="site-footer"><div class="container footer-top"><div class="footer-brand"><a href={path()} class="wordmark">ALFAWALI<span>.</span></a><p>Produtos, suprimentos<br/>e serviços para empresas.</p><label class="theme-control" data-theme-control hidden><span>Aparência</span><select data-theme-select aria-label="Aparência"><option value="system">Sistema</option><option value="light">Claro</option><option value="dark">Escuro</option></select></label></div><div><h2>Navegue</h2>{nav.slice(1).map(item => <a href={path(item.href)}>{item.name}</a>)}</div><div><h2>Contato e atendimento</h2><a href={contact()} target="_blank" rel="noopener noreferrer">WhatsApp {company.phoneDisplay}</a><a href={`tel:+${company.whatsapp}`}>Ligar para a ALFAWALI</a><a href={path('atendimento/')}>Consultar minha região</a><p class="footer-pending">Canal comercial em validação.<br/>E-mail e horários a confirmar.</p></div><div class="footer-note"><h2>Identificação da empresa</h2><p>{company.legalName}</p><p>CNPJ: {company.cnpj}</p></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} ALFAWALI · Prévia</span><a href={path('privacidade/')}>Privacidade</a><a href={path('condicoes/')}>Condições comerciais</a><span>Disponibilidade sob consulta.</span></div></footer>
  </div>
  {!quotePage && <a class="floating-whatsapp" href={contact()} target="_blank" rel="noopener noreferrer" aria-label="Conversar com a ALFAWALI no WhatsApp"><Icon name="chat"/></a>}
  <div role="status" aria-live="polite" class="toast" data-toast hidden></div>
  <dialog class="quote-dialog" id="quote-dialog" aria-labelledby="quote-title"><div class="quote-head"><div><span class="eyebrow">SUA SELEÇÃO</span><h2 id="quote-title">Minha cotação<span>.</span></h2></div><button type="button" class="icon-button" data-close-quote aria-label="Fechar cotação"><Icon name="close"/></button></div>{!quotePage && <QuoteForm/>}</dialog>
  <noscript><div class="noscript-note">Para usar a busca e montar a cotação, ative o JavaScript. Você também pode falar pelo WhatsApp {company.phoneDisplay}.</div></noscript>
  <script>import '../scripts/theme'; import '../scripts/app';</script>
</body></html>
