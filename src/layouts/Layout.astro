---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { company } from '../data/company';
import { path, contact, catalogContact } from '../lib/urls';
import Icon from '../components/Icon.astro';
import QuoteForm from '../components/QuoteForm.astro';
const quotePage = Astro.url.pathname.endsWith('/orcamento/');
import { isProd } from '../lib/env';
interface Props { title: string; description?: string; active?: string }
const { title, description = 'Produtos de limpeza, higiene e suprimentos, terceirização e serviços para empresas no Rio Grande do Sul. Conheça a ALFAWALI.', active = '' } = Astro.props;
const nav = [{ name: 'Início', href: '', id: 'home' }, { name: 'A empresa', href: 'empresa/', id: 'empresa' }, { name: 'Serviços', href: 'servicos/', id: 'servicos' }, { name: 'Produtos', href: 'produtos/', id: 'produtos' }, { name: 'Atendimento', href: 'atendimento/', id: 'atendimento' }, { name: 'Contato', href: 'contato/', id: 'contato' }];
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const csp = "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'";
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>{import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp}/>}<meta name="referrer" content="strict-origin-when-cross-origin"/><title>{title} | ALFAWALI</title><meta name="description" content={description}/>{isProd ? <meta name="robots" content="index, follow"/> : <meta name="robots" content="noindex, nofollow"/>}{isProd && canonical && <link rel="canonical" href={canonical}/>}<meta name="theme-color" content="#203d4e"/><meta property="og:title" content={`${title} | ALFAWALI`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="pt_BR"/><link rel="icon" type="image/svg+xml" href={path('favicon.svg')}/></head>
<body>
  <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
  {company.demo && <div class="preview-bar"><span class="status-dot"></span> Apresentação ALFAWALI <span class="preview-divider">/</span><span>Catálogo demonstrativo</span></div>}
  <header class="site-header"><div class="container nav-row"><a class="brand" href={path()} aria-label="ALFAWALI - início"><img src={path('images/logo.png')} alt="ALFAWALI" width="115" height="80" fetchpriority="high"/></a><button class="menu-button" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="main-nav" data-menu><Icon name="menu"/></button><nav id="main-nav" aria-label="Menu principal">{nav.map(item => <a href={path(item.href)} aria-current={active === item.id ? 'page' : undefined}>{item.name}</a>)}</nav><a class="quote-trigger" href={path("orcamento/")} data-open-quote><Icon name="list" size={20}/><span>Minha cotação</span><span class="cart-count" data-cart-count aria-label="itens na cotação">0</span></a></div></header>
  <main id="conteudo"><slot/></main>
  <footer class="site-footer"><div class="container footer-top"><div class="footer-brand"><a href={path()} class="wordmark">ALFAWALI</a><p>Produtos e serviços.<br/>Cuidado com a sua operação.</p><span class="region"><Icon name="pin" size={16}/> Rio Grande do Sul</span></div><div><h2>Explore</h2>{nav.slice(1).map(item => <a href={path(item.href)}>{item.name}</a>)}</div><div><h2>Atendimento</h2><a href={contact()} target="_blank" rel="noopener noreferrer">WhatsApp {company.phoneDisplay}</a><a href={`tel:+${company.whatsapp}`}>Televendas</a><a href={catalogContact} target="_blank" rel="noopener noreferrer">Solicitar catálogo completo</a></div><div class="footer-note"><h2>ALFAWALI</h2><p>{company.legalName}</p><p>CNPJ: {company.cnpj}</p></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} ALFAWALI. Apresentação do projeto.</span><a href={path('privacidade/')}>Privacidade</a><a href={path('condicoes/')}>Condições</a><span>Produtos ilustrativos. Consulte disponibilidade.</span></div></footer>
  {!quotePage && <a class="floating-whatsapp" href={contact()} target="_blank" rel="noopener noreferrer" aria-label="Conversar com a ALFAWALI no WhatsApp"><Icon name="chat"/></a>}
  <div role="status" aria-live="polite" class="toast" data-toast hidden></div>
  <dialog class="quote-dialog" id="quote-dialog" aria-labelledby="quote-title"><div class="quote-head"><div><span class="eyebrow">SUA SELEÇÃO</span><h2 id="quote-title">Minha cotação<span>.</span></h2></div><button type="button" class="icon-button" data-close-quote aria-label="Fechar cotação"><Icon name="close"/></button></div>{!quotePage && <QuoteForm/>}</dialog>
  <noscript><div class="noscript-note">Para usar a busca e montar a cotação, ative o JavaScript. Você também pode falar pelo WhatsApp {company.phoneDisplay}.</div></noscript>
  <script>import '../scripts/app';</script>
</body></html>
