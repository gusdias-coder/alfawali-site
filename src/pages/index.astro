---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductArt from '../components/ProductArt.astro';
import ProductCard from '../components/ProductCard.astro';
import CTA from '../components/CTA.astro';
import { categories } from '../data/company';
import { products } from '../data/products';
import { path } from '../lib/urls';
const leading: string[] = ['quimicos', 'papeis', 'copos', 'equipamentos'];
const featured = ['quimicos-01', 'papeis-01', 'copos-01', 'office-01'].map(id => products.find(p => p.id === id)!);
const orderedCategories = [...categories].sort((a,b) => (leading.indexOf(a.id) < 0 ? 10 : leading.indexOf(a.id)) - (leading.indexOf(b.id) < 0 ? 10 : leading.indexOf(b.id)));
---
<Layout title="Produtos de limpeza e suprimentos para empresas" active="home">
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow">ALFAWALI · PRODUTOS PARA EMPRESAS</span><h1>Produtos de limpeza<br/>e suprimentos<br/><em>para empresas.</em></h1><p>Limpeza, higiene, descartáveis e materiais de apoio. Explore as linhas e organize sua solicitação de orçamento.</p><div class="hero-actions"><a class="button button-red" href={path('produtos/')}>Explorar produtos <Icon size={19}/></a><a class="button button-outline" href={path('orcamento/')}>Solicitar orçamento <Icon name="diagonal" size={18}/></a></div><p class="hero-foot"><Icon name="pin" size={17}/> Consulte disponibilidade e atendimento para sua cidade.</p></div><aside class="hero-directory" aria-labelledby="hero-lines"><div class="directory-heading"><span class="eyebrow">ENCONTRE POR LINHA</span><span class="directory-count">01 — 04</span></div><h2 id="hero-lines">O que sua empresa precisa?</h2><div class="directory-links">{orderedCategories.slice(0,4).map(category => <a href={path(`produtos/categoria/${category.id}/`)}><Icon name={category.icon} size={22}/><div><strong>{category.name}</strong><span>{category.description}</span></div><Icon name="diagonal" size={18}/></a>)}</div><a class="directory-all" href={path('produtos/')}>Ver todas as linhas <Icon size={17}/></a></aside></div></section>
  <section class="category-section container" id="linhas" aria-labelledby="lines-title"><div class="section-heading"><div><span class="eyebrow">CATÁLOGO ALFAWALI</span><h2 id="lines-title">Escolha uma categoria.</h2></div><span class="section-note">Ilustrações e itens demonstrativos</span></div><div class="category-grid">{orderedCategories.map(category => <a class="category-card" href={path(`produtos/categoria/${category.id}/`)}><div class="category-art"><ProductArt kind={category.icon}/></div><div class="category-bottom"><h3>{category.name}</h3><Icon name="diagonal" size={17}/></div></a>)}</div></section>
  <section class="section section-tinted"><div class="container"><div class="section-heading"><div><span class="eyebrow">EXPLORE OS ITENS</span><h2>Do catálogo à sua cotação.</h2></div><a class="text-link" href={path('produtos/')}>Ver todos os produtos <Icon size={18}/></a></div><p class="section-note featured-note">Seleção demonstrativa. Marcas, embalagens e disponibilidade serão confirmadas pela ALFAWALI.</p><div class="products-grid featured-grid">{featured.map(product => <ProductCard product={product}/>)}</div></div></section>
  <section class="services-section"><div class="container services-home"><div><span class="eyebrow">UMA FRENTE DE SERVIÇOS</span><h2>Sua operação também<br/>precisa de pessoas.</h2><p>A ALFAWALI atua com terceirização de mão de obra. Atividades, equipe, locais e condições são definidos após a avaliação da demanda.</p><a class="button button-white" href={path('servicos/')}>Conhecer os serviços <Icon name="diagonal" size={18}/></a></div><div class="service-home-note"><Icon name="people" size={42}/><h3>Vamos entender o escopo.</h3><p>Informe o tipo de atividade, a cidade e a rotina que precisa de apoio.</p><a class="text-link light" href={path('contato/')}>Solicitar avaliação <Icon size={18}/></a></div></div></section>
  <section class="section container approach"><div><span class="eyebrow">ORÇAMENTO POR WHATSAPP</span><h2>Selecione. Revise.<br/>Converse com a equipe.</h2><p>A lista organiza a consulta. Preços, disponibilidade e condições são tratados no atendimento.</p></div><ol class="steps"><li><span>01</span><div><h3>Encontre os itens</h3><p>Use a busca ou navegue pelas categorias.</p></div></li><li><span>02</span><div><h3>Revise sua lista</h3><p>Confira quantidades, unidade e sua mensagem.</p></div></li><li><span>03</span><div><h3>Abra o WhatsApp</h3><p>Você decide quando enviar a solicitação. O site não envia automaticamente.</p></div></li></ol></section>
  <CTA/>
</Layout>
