---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductArt from '../components/ProductArt.astro';
import CTA from '../components/CTA.astro';
import { categories, services } from '../data/company';
import { path, contact } from '../lib/urls';
---
<Layout title="Produtos e serviços para sua empresa" active="home">
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow"><span class="short-rule"></span> PRODUTOS + SERVIÇOS</span><h1>Limpeza, suprimentos<br/>e pessoas para<br/><em>sua operação.</em></h1><p>Produtos de limpeza, higiene e descartáveis, junto à terceirização de mão de obra. Duas frentes para atender às necessidades da sua empresa.</p><div class="hero-actions"><a class="button button-red" href={path('produtos/')}>Explorar produtos <Icon size={19}/></a><a class="text-link" href={path('servicos/')}>Conhecer serviços <Icon name="diagonal" size={17}/></a></div><div class="hero-foot"><Icon name="pin" size={18}/><span>Consulte o atendimento para sua cidade</span></div></div><div class="hero-visual"><img class="hero-brand-image" src={path('images/brand-wall.webp')} width="843" height="771" alt="Aplicação visual da marca ALFAWALI em vermelho e azul-escuro" fetchpriority="high"/><div class="hero-caption"><span>APLICAÇÃO ILUSTRATIVA DA MARCA</span><Icon name="diagonal" size={24}/></div><div class="hero-stamp"><span>ALFAWALI</span><strong>Presente na<br/>sua rotina.</strong><span class="stamp-plus">+</span></div></div></div></section>
  <section class="intro-strip"><div class="container strip-grid"><p>Seu negócio em movimento.<br/><strong>A ALFAWALI ao seu lado.</strong></p><div><Icon name="bottle"/><span>Produtos para<br/>o dia a dia</span></div><div><Icon name="people"/><span>Serviços para<br/>a sua empresa</span></div><div><Icon name="chat"/><span>Atendimento<br/>direto e próximo</span></div></div></section>
  <section class="section container" id="linhas"><div class="section-heading"><div><span class="eyebrow">NOSSO UNIVERSO DE PRODUTOS</span><h2>O essencial para cada<br/>parte da sua rotina.</h2></div><a class="text-link" href={path('produtos/')}>Ver catálogo demonstrativo <Icon size={18}/></a></div><div class="category-grid">{categories.map((category, i) => <a class="category-card" href={path(`produtos/categoria/${category.id}/`)}><span class="category-number">0{i+1}</span><div class="category-art"><ProductArt kind={category.icon}/></div><div class="category-bottom"><div><h3>{category.name}</h3><p>{category.label}</p></div><span class="round-arrow"><Icon name="diagonal" size={18}/></span></div></a>)}</div></section>
  <section class="services-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">PESSOAS E AMBIENTES</span><h2>Mais apoio para você<br/>cuidar do seu negócio.</h2></div><p class="heading-description">Conheça a frente de serviços da ALFAWALI. Conte sua necessidade e encontre o atendimento adequado para sua operação.</p></div><div class="service-list">{services.map(service => <a href={path(`servicos/#${service.id}`)} class="service-row"><span class="service-number">{service.number}</span><Icon name={service.icon} size={34}/><div><h3>{service.title}</h3><p>{service.items[0]} e atendimento sob consulta.</p></div><span class="round-arrow"><Icon name="diagonal"/></span></a>)}</div></div></section>
  <section class="section container approach"><div><span class="eyebrow">DO INTERESSE À CONVERSA</span><h2>Sua necessidade.<br/>Uma conversa.<br/><em>Novas possibilidades.</em></h2><a class="text-link" href={contact()} target="_blank" rel="noopener noreferrer">Fale com a gente <Icon name="diagonal" size={18}/></a></div><ol class="steps"><li><span>01</span><div><h3>Explore as linhas</h3><p>Conheça os produtos e os serviços que fazem sentido para sua empresa.</p></div></li><li><span>02</span><div><h3>Monte sua seleção</h3><p>Escolha os itens e as quantidades no catálogo demonstrativo.</p></div></li><li><span>03</span><div><h3>Converse pelo WhatsApp</h3><p>Envie sua seleção e combine os detalhes diretamente com o atendimento.</p></div></li></ol></section>
  <CTA/>
</Layout>
