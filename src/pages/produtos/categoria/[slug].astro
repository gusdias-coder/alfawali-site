---
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { categories } from '../../../data/company';
import { products } from '../../../data/products';
import { path } from '../../../lib/urls';
export function getStaticPaths() {
  // Categoria sem produto válido não é publicada (RF03).
  return categories.filter(c => products.some(p => p.category === c.id)).map(category => ({ params: { slug: category.id }, props: { category } }));
}
const { category } = Astro.props;
const items = products.filter(p => p.category === category.id);
---
<Layout title={category.name} description={category.description} active="produtos">
  <div class="container">
    <nav class="product-breadcrumb" aria-label="Caminho"><a href={path()}>Início</a><span aria-hidden="true">/</span><a href={path('produtos/')}>Produtos</a><span aria-hidden="true">/</span><span aria-current="page">{category.name}</span></nav>
  </div>
  <section class="page-hero container catalog-hero"><div><h1>{category.name}<em>.</em></h1><p>{category.description}</p></div></section>
  <section class="container catalog-section"><nav class="category-nav" aria-label="Categorias"><a href={path('produtos/')}>Todas as linhas</a>{categories.map(item => <a href={path(`produtos/categoria/${item.id}/`)} aria-current={item.id === category.id ? 'page' : undefined}>{item.name}</a>)}</nav><div class="catalog-results"><p role="status">{items.length} {items.length === 1 ? 'item demonstrativo' : 'itens demonstrativos'} nesta categoria</p><a class="text-link" href={`${path('produtos/')}?categoria=${category.id}`}>Buscar nesta linha →</a></div><div class="products-grid">{items.map(product => <ProductCard product={product}/>)}</div></section>
</Layout>
