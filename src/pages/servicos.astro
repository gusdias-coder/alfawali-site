---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import ServiceProcess from '../components/ServiceProcess.astro';
import ServiceFaq from '../components/ServiceFaq.astro';
import { services } from '../data/company';
import { path } from '../lib/urls';
---
<Layout title="Serviços e terceirização" description="Conheça a terceirização de mão de obra da ALFAWALI e consulte a viabilidade de outros escopos de apoio. Região e condições sujeitas à avaliação." active="servicos">
  <section class="page-hero container"><span class="eyebrow">SERVIÇOS ALFAWALI</span><h1>Terceirização e apoio<br/>à sua <em>operação.</em></h1><p>Entenda cada frente e informe sua necessidade. A disponibilidade, a região e as condições são confirmadas no atendimento.</p></section>
  <section class="container service-details" aria-label="Frentes de serviços">{services.map(service => <article id={service.id} class="service-detail"><div class="service-symbol"><span>{service.number}</span><Icon name={service.icon} size={72}/></div><div><span class="eyebrow">{service.confirmed ? 'FRENTE DE ATUAÇÃO' : 'ESCOPO PARA CONSULTA'}</span><h2><a href={path(`servicos/${service.id}/`)}>{service.title}</a></h2><p>{service.description}</p>{!service.confirmed && <p class="form-help">Escopo e oferta ativa sujeitos à confirmação da empresa.</p>}<ul class="check-list">{service.items.map(item => <li><Icon name="check" size={18}/>{item}</li>)}</ul><a class="button button-dark" href={path(`servicos/${service.id}/`)}>Ver escopo e contratação <Icon name="diagonal" size={18}/></a></div></article>)}</section>
  <ServiceProcess/>
  <ServiceFaq/>
  <CTA/>
</Layout>
