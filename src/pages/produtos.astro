---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import { categories } from '../data/company';
import { products } from '../data/products';
import { catalogContact } from '../lib/urls';
---
<Layout title="Catálogo de produtos" active="produtos"><section class="page-hero container catalog-hero"><div><span class="eyebrow">PRODUTOS ALFAWALI</span><h1>Encontre o que sua<br/>rotina <em>precisa.</em></h1><p>Explore as linhas, selecione os itens e prepare sua cotação.</p></div><a class="text-link" href={catalogContact} target="_blank" rel="noopener noreferrer">Solicitar catálogo completo <Icon name="diagonal" size={18}/></a></section><section class="container catalog-section"><div class="demo-notice"><Icon name="shield" size={20}/><p><strong>Catálogo demonstrativo.</strong> Os itens e as ilustrações abaixo são exemplos para apresentação. Marcas, embalagens e disponibilidade serão confirmadas pela ALFAWALI.</p></div><div class="catalog-tools"><label class="search-input"><Icon name="search" size={20}/><span class="sr-only">Buscar produtos</span><input type="search" id="product-search" placeholder="O que você procura?" maxlength="120" autocomplete="off"/></label><label class="sort-label">Ordenar<select id="product-sort"><option value="category">Por categoria</option><option value="az">Nome: A a Z</option><option value="za">Nome: Z a A</option></select></label></div><div class="catalog-layout"><aside class="catalog-sidebar"><h2>Linhas de produtos</h2><div class="category-filters"><button type="button" data-category-filter="all" aria-pressed="true">Todas as linhas <span>{products.length}</span></button>{categories.map(cat => <button type="button" data-category-filter={cat.id} aria-pressed="false"><span><Icon name={cat.icon} size={18}/>{cat.name}</span><span>{products.filter(p => p.category === cat.id).length}</span></button>)}</div><div class="catalog-help"><Icon name="chat" size={26}/><h3>Não encontrou?</h3><p>Converse com a gente e solicite o catálogo completo.</p><a class="text-link" href={catalogContact} target="_blank" rel="noopener noreferrer">Falar com atendimento <Icon size={17}/></a></div></aside><div class="catalog-main"><div class="catalog-results"><p id="results-count" role="status" aria-live="polite">{products.length} exemplos de produtos</p><button class="text-button" data-clear-filters type="button">Limpar filtros</button></div><div class="products-grid" id="products-grid">{products.map(product => <ProductCard product={product}/>)}</div><div class="no-results" id="no-results" hidden><Icon name="search" size={38}/><h2>Nenhum item encontrado.</h2><p>Tente outro nome ou explore todas as linhas.</p><button type="button" class="button button-dark" data-clear-filters>Ver todos os produtos</button></div></div></div></section></Layout>
