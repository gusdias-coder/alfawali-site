---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { company } from '../data/company';
---
<Layout title="Orçamento" description="Monte a lista de produtos, revise a mensagem e abra o WhatsApp para solicitar uma proposta." active="produtos">
  <section class="page-hero container"><div><h1>Sua lista de <em>orçamento.</em></h1><p>Escolha os produtos, revise a mensagem e abra o WhatsApp. Preparar a mensagem não envia a solicitação: o envio acontece no WhatsApp, por você.</p></div></section>
  <section class="container catalog-section">
    <div class="quote-page"><QuoteForm/></div>
    <p class="form-help">Sem JavaScript? Fale direto pelo WhatsApp {company.phoneDisplay}.</p>
  </section>
</Layout>
