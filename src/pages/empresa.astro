---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { clients, company } from '../data/company';
import { path } from '../lib/urls';
---
<Layout title="A empresa" active="empresa"><section class="page-hero container"><span class="eyebrow">CONHEÇA A ALFAWALI</span><h1>Uma visão integrada<br/>do seu <em>dia a dia.</em></h1><p>Produtos e serviços que se encontram nas necessidades reais de uma operação.</p></section><section class="container company-story"><div class="story-image"><img src={path('images/brand-wall.webp')} width="843" height="771" alt="Identidade visual ALFAWALI"/></div><div><span class="eyebrow">NOSSA ORIGEM</span><h2>Da experiência com serviços<br/>à oferta de suprimentos.</h2><p>A ALFAWALI reúne a prestação de serviços de terceirização de mão de obra e a comercialização de produtos de limpeza, higiene e embalagens descartáveis.</p><p>A ideia parte de uma necessidade prática: aproximar o fornecimento de materiais da rotina de quem já atua com terceirização de mão de obra. Limpeza, higiene, descartáveis e suprimentos passam a fazer parte dessa proposta.</p><p>O fornecimento de produtos e a execução dos serviços são avaliados separadamente. Consulte as condições e a disponibilidade para sua cidade.</p><a class="text-link" href={path('contato/')}>Vamos nos conhecer <Icon name="diagonal" size={18}/></a></div></section><section class="section container"><div class="section-heading"><div><span class="eyebrow">DUAS FRENTES. UMA ALFAWALI.</span><h2>O que fazemos.</h2></div></div><div class="two-panels"><a class="feature-panel" href={path('produtos/')}><Icon name="bottle" size={40}/><h3>Produtos para abastecer</h3><p>Produtos de limpeza, higiene e embalagens descartáveis. O catálogo desta prévia ainda apresenta exemplos para revisão.</p><span class="text-link">Explorar produtos <Icon size={18}/></span></a><a class="feature-panel navy" href={path('servicos/')}><Icon name="people" size={40}/><h3>Serviços para apoiar</h3><p>Terceirização de mão de obra, limpeza e apoio à operação, com escopo definido no atendimento.</p><span class="text-link light">Conhecer serviços <Icon size={18}/></span></a></div></section><section class="container prose"><h2>Identificação da empresa</h2><p>{company.legalName}</p><p>CNPJ: {company.cnpj}</p></section>{clients.length > 0 && <section class="clients-section"><div class="container"><h2>Clientes e parceiros</h2><div class="client-grid">{clients.map(client => <img src={path(client.logo)} alt={client.name} loading="lazy"/>)}</div></div></section>}<CTA/></Layout>
