---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import { clients, company } from '../data/company';
import { path } from '../lib/urls';
---
<Layout title="A empresa" active="empresa">
  <section class="page-hero container"><span class="eyebrow">CONHEÇA A ALFAWALI</span><h1>Fornecimento de produtos.<br/><em>Prestação de serviços.</em></h1><p>Duas frentes de atuação para conversar sobre as necessidades da sua empresa.</p></section>
  <section class="container company-story"><div class="company-identity"><span class="eyebrow">IDENTIFICAÇÃO DA EMPRESA</span><strong>ALFAWALI<span>.</span></strong><p>{company.legalName}</p><p>CNPJ {company.cnpj}</p><span class="section-note">Dados cadastrais da base fornecida. Conteúdo comercial em revisão.</span></div><div><span class="eyebrow">O QUE FAZEMOS</span><h2>Materiais e mão de obra<br/>em frentes distintas.</h2><p>A ALFAWALI reúne a prestação de serviços de terceirização de mão de obra e a comercialização de produtos de limpeza, higiene e embalagens descartáveis.</p><p>Consulte os itens e descreva a demanda da sua operação. Produtos, atividades, locais e condições são avaliados no atendimento.</p><p>O catálogo desta prévia apresenta exemplos. A seleção real de produtos e a cobertura serão confirmadas pelo responsável.</p><a class="text-link" href={path('contato/')}>Falar com a ALFAWALI <Icon name="diagonal" size={18}/></a></div></section>
  <section class="section container"><div class="two-panels"><a class="feature-panel" href={path('produtos/')}><Icon name="bottle" size={32}/><h3>Explore os produtos</h3><p>Linhas de limpeza, higiene, descartáveis e suprimentos organizadas para consulta e cotação.</p><span class="text-link">Ver catálogo <Icon size={18}/></span></a><a class="feature-panel navy" href={path('servicos/')}><Icon name="people" size={32}/><h3>Consulte os serviços</h3><p>Terceirização de mão de obra e avaliação do escopo necessário à sua empresa.</p><span class="text-link light">Conhecer serviços <Icon size={18}/></span></a></div></section>
  {clients.length > 0 && <section class="clients-section"><div class="container"><h2>Clientes e parceiros</h2><div class="client-grid">{clients.map(client => <img src={path(client.logo)} alt={client.name} width="120" height="80" loading="lazy"/>)}</div></div></section>}
  <CTA/>
</Layout>
