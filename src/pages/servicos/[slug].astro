---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import ServiceProcess from '../../components/ServiceProcess.astro';
import ServiceFaq from '../../components/ServiceFaq.astro';
import { services } from '../../data/company';
import { path } from '../../lib/urls';
export function getStaticPaths() { return services.map(service => ({params:{slug:service.id},props:{service}})); }
const {service} = Astro.props;
---
<Layout title={service.title} description={service.description} active="servicos">
  <nav class="container product-breadcrumb" aria-label="Caminho do serviço"><a href={path()}>Início</a><span aria-hidden="true">/</span><a href={path('servicos/')}>Serviços</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span></nav>
  <section class="container service-detail service-detail-hero"><div class="service-symbol" aria-hidden="true"><span>{service.number}</span><Icon name={service.icon} size={72}/></div><div><span class="eyebrow">SERVIÇOS ALFAWALI</span><h1>{service.title}<em>.</em></h1><p>{service.description}</p>{!service.confirmed && <p class="demo-notice service-status">Escopo em validação. Esta página permite consultar a viabilidade; não confirma a oferta ativa deste serviço.</p>}<div class="hero-actions"><a class="button button-red" href={`${path('contato/')}?servico=${service.id}`}>Solicitar avaliação <Icon name="diagonal" size={18}/></a><a class="text-link" href={path('atendimento/')}>Consultar atendimento <Icon size={18}/></a></div></div></section>
  <section class="container service-scope"><div class="two-panels"><article class="feature-panel"><span class="eyebrow">ESCOPO DA CONSULTA</span><h2>O que avaliar.</h2><ul class="check-list">{service.items.map(item => <li><Icon name="check" size={18}/>{item}</li>)}</ul></article><article class="feature-panel"><span class="eyebrow">LOCAL E CONDIÇÕES</span><h2>Atendimento sob consulta.</h2><p>Informe sua cidade no Rio Grande do Sul. Equipe, materiais, horários, atividades incluídas e exclusões dependem de avaliação e confirmação na proposta.</p><a class="text-link" href={path('condicoes/')}>Condições da solicitação →</a></article></div></section>
  <ServiceProcess/>
  <ServiceFaq/>
  <section class="container service-next"><a class="button button-red" href={`${path('contato/')}?servico=${service.id}`}>Consultar este serviço <Icon name="diagonal" size={18}/></a><a class="text-link" href={path('servicos/')}>← Ver outros escopos</a></section>
</Layout>
